{
  "manifest_version": 3,
  "name": "HonEx",
  "version": "1.0.0",
  "description": "Real-time phishing detection powered by on-device machine learning. All analysis happens locally in your browser.",
  "author": "Aldi Nova",

  "icons": {
    "16": "assets/Logo.png",
    "48": "assets/Logo.png",
    "128": "assets/Logo.png"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/Logo.png",
      "48": "assets/Logo.png",
      "128": "assets/Logo.png"
    },
    "default_title": "HonEx"
  },

  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  },

  "options_ui": {
    "page": "settings/settings.html",
    "open_in_tab": true
  },

  "permissions": [
    "webNavigation",
    "storage",
    "tabs",
    "notifications",
    "dns"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "ml/rf_trees.json",
        "warning/warning.html"
      ],
      "matches": ["<all_urls>"]
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
